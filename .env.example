# Copy to .env and fill in. Used by the backend, produce.py, scripts/ and Docker Compose.

# Kafka API + Schema Registry (a Redpanda SASL/SCRAM user with produce/consume on the topics)
RP_BOOTSTRAP=seed-xxxx.<cluster-id>.byoc.prd.cloud.redpanda.com:9092
RP_SR_URL=https://schema-registry-xxxx.<cluster-id>.byoc.prd.cloud.redpanda.com:30081
RP_USER=taxi-lab
RP_PASS=
RP_SASL_MECHANISM=SCRAM-SHA-256

# Redpanda SQL (Cloud Console > How to connect > SQL)
RP_SQL_HOST=<sql-endpoint>
RP_SQL_PORT=5432
RP_SQL_DB=oxla
# scram: RP_SQL_USER = service account email, password set with ALTER USER ... WITH PASSWORD
# client_secret: RP_SQL_USER = service account client ID, RP_SQL_PASSWORD = client secret
RP_SQL_AUTH=scram
RP_SQL_USER=
RP_SQL_PASSWORD=
RP_SQL_CATALOG=default_redpanda_catalog

# Demo behaviour (defaults shown)
# ICEBERG_LAG_MS=60000
# REPLAY_WEEKS=4
# LIVE_POLL_S=2

# Connect pipelines. RP_USER, RP_PASS and RP_SQL_DSN are pushed to the Cloud Secrets Store by
# scripts/deploy_pipelines.py, or read directly when the pipelines run self-hosted.
# <sql-user> is the service account email, URL-encoded (@ -> %40); see README §2
RP_SQL_DSN=postgres://<sql-user>:<sql-password>@<sql-endpoint>:5432/oxla?sslmode=require
# Data Plane API for scripts/deploy_pipelines.py (token defaults to `rpk cloud auth token`)
DATAPLANE_URL=https://api-<id>.<cluster-id>.byoc.prd.cloud.redpanda.com
# DATAPLANE_TOKEN=
# Only for running the Connect pipelines self-hosted (compose profile "connect")
REDPANDA_BROKERS=${RP_BOOTSTRAP}
REDPANDA_SCHEMA_REGISTRY_URL=${RP_SR_URL}
